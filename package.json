  "scripts": {
    "dev": "npm run frontend",
    "start": "npm run frontend",
    "frontend": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "backend": "powershell -Command \"cd backend; .venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000\"",
    "build": "npm run build --prefix frontend",
    "test": "powershell -Command \"cd backend; .venv\\Scripts\\python.exe -m unittest backend/test_acceptance_suite.py\"",
    "test:acceptance": "powershell -Command \"cd backend; .venv\\Scripts\\python.exe -m unittest backend/test_acceptance_suite.py\"",
    "test:verify": "powershell -Command \"& backend/.venv/Scripts/python.exe backend/verify_all.py\""
  }
